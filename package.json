{
  "name": "omnigo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "OmniGo - Vehicle Towing App Ecosystem",
  "scripts": {
    "start": "pnpm dev:user",
    "dev:user": "pnpm --filter user-app lan",
    "dev:vendor": "pnpm --filter vendor-app lan",
    "tunnel:user": "pnpm --filter user-app tunnel",
    "tunnel:vendor": "pnpm --filter vendor-app tunnel",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:api": "pnpm --filter api-server dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.12.1",
  "overrides": {
    "expo": "~58.0.19",
    "@expo/log-box": "~58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "@expo/dom-webview": "~58.0.2",
    "@react-native/metro-config": "0.88.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  }
}

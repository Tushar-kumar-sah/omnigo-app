{
  "name": "omnigo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "OmniGo - Vehicle Towing App Ecosystem",
  "scripts": {
    "start": "pnpm dev:user",
    "dev:user": "pnpm --filter user-app lan",
    "dev:vendor": "pnpm --filter vendor-app lan",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:api": "pnpm --filter api-server dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.12.1",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}

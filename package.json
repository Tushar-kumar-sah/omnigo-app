{
  "name": "omnigo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "OmniGo - Vehicle Towing App Ecosystem",
  "scripts": {
    "start": "pnpm dev:user",
    "dev:user": "pnpm --filter user-app lan",
    "dev:vendor": "pnpm --filter vendor-app lan",
    "tunnel:user": "pnpm --filter user-app tunnel",
    "tunnel:vendor": "pnpm --filter vendor-app tunnel",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:api": "pnpm --filter api-server dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.12.1",
  "overrides": {
    "expo": "~57.0.0",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "~57.0.15",
    "expo-blur": "57.0.3",
    "expo-linear-gradient": "57.0.2",
    "expo-font": "57.0.4",
    "expo-constants": "57.0.18",
    "expo-asset": "57.0.17",
    "expo-file-system": "57.0.7",
    "expo-router": "57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}

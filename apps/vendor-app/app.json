{
  "expo": {
    "name": "OmniGo Driver",
    "slug": "omnigo-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "omnigo-driver",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.omnigo.vendorapp",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E17"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OmniGo Driver collects location data to route you to broken-down vehicles and share live tracking with customers even when the app is running in the background."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OmniGo Driver requires camera access for selfie identity verification and vehicle condition inspection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniGo Driver accesses your documents and photos to verify commercial driving licenses and vehicle registration."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0E17"
        }
      ]
    ]
  }
}

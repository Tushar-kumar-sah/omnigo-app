{
  "expo": {
    "name": "OmniGo",
    "slug": "omnigo",
    "scheme": "omnigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.omnigo.userapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E17"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0E17"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5db453d-477c-440c-bfc3-87a0c20b14fe"
      }
    },
    "owner": "tushar-kr-sah"
  }
}
